# Railway build context. Never upload local workspace credentials or runtime data.
.git
**/.env
**/.env.*
!**/.env.example
**/node_modules
**/.venv
**/dist
**/__pycache__
**/.pytest_cache
**/.secrets
**/private_assets
**/storage
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.har
**/*.pem
**/*.key
**/*.zip
docs/
vendor/
reports/
tmp/
