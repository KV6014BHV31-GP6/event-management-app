# Copy to backend/.env and edit locally. Never commit actual credentials.
ENVIRONMENT=development
PROJECT_NAME=NU Event Management (local development)
API_V1_STR=/api/v1
DATABASE_URL=postgresql://nu_event_dev:replace-with-local-db-password@127.0.0.1:5432/nu_event_dev
JWT_SECRET_KEY=replace-with-a-random-secret-generated-locally
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional: 12–72 UTF-8 bytes for the synthetic demo_organizer account.
# When blank, dev_bootstrap generates a password into ignored backend/.env.seed.
# Existing seed account passwords are never overwritten.
SEED_PASSWORD=
